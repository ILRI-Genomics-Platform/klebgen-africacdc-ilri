/*
========================================================================================
    Test profile: tiny placeholder reads for checking the pipeline wiring.
    Run with -stub (no tools are executed):
        nextflow run main.nf -profile test -stub --outdir test_results
    8 samples: an ST39 group of 4 (one with ONT reads), an ST35 group of 2
    (skipped: below phylo_min_group_size), one ungrouped K. pneumoniae and
    one E. coli with ONT reads. In stub runs Kleborate reports each sample's
    phylo_group as its ST (NA when empty), so --phylo_grouping kleborate and
    samplesheet form the same groups (Kpneumoniae_ST39 / ST39); the default,
    species, puts the 6 K. pneumoniae with an ST in one group (Kpneumoniae).
========================================================================================
*/

params {
    input            = "${projectDir}/assets/test_data/samplesheet_test.csv"
    amrfinderplus_db = null
    kraken2_db       = null
    // Placeholder reference genomes for the phylogeny step (stub runs only)
    phylo_reference_dir = "${projectDir}/assets/test_data/references"
}

process {
    resourceLimits = [cpus: 2, memory: 4.GB, time: 1.h]
}
