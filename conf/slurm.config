/****************************************************************
 ********* Slurm configuration for ILRI HPC clusters ************
 ****************************************************************
 *
 *  nextflow run main.nf -profile singularity -c conf/slurm.config \
 *      --input samplesheet.csv --outdir results --kraken2_db /path/to/k2db
 *
 *  Tools run from the shared, read-only Singularity images prepared by a
 *  trainer (bin/prepare_shared_containers.sh); nothing is downloaded.
 *  Set shared_container_dir below once for the course.
 ***************************************************************/

params {
    // Read-only folder with the course images (nf-core/ and local/ inside)
    shared_container_dir = '/var/scratch/global/jjuma/neonatal-amr/shared/containers'
    // Read-only folder with the phylogeny reference genomes (bin/fetch_references.py)
    phylo_reference_dir  = '/var/scratch/global/jjuma/neonatal-amr/shared/references'
}

profiles {
  singularity {
    // Shared images: libraryDir/cacheDir and the local-module images
    includeConfig 'singularity_images.config'

    process {
        // Run on each compute node before every task (load what the nodes need)
        beforeScript = 'module load nextflow/25.04'
        executor = 'slurm'
        queue = 'batch'
        clusterOptions = ''
        scratch = true
        // Bind scratch and, when given, the Kraken2 database
        containerOptions = {
            params.kraken2_db ? "--bind /var/scratch --bind ${params.kraken2_db}:${params.kraken2_db}" : "--bind /var/scratch"
        }

        // Largest request allowed: set to the biggest node you will use
        resourceLimits = [cpus: 16, memory: 288.GB, time: 72.h]

        cpus   = { 1      * task.attempt }
        memory = { 6.GB   * task.attempt }
        time   = { 4.h    * task.attempt }

        errorStrategy = { task.exitStatus in ((130..145) + 104 + 175 + 255) ? 'retry' : 'finish' }
        maxRetries = 2
        maxErrors = '-1'

        withLabel:process_single {
            cpus   = { 2                   }
            memory = { 6.GB * task.attempt }
            time   = { 4.h  * task.attempt }
        }
        withLabel:process_low {
            cpus   = { 4     * task.attempt }
            memory = { 16.GB * task.attempt }
            time   = { 4.h   * task.attempt }
        }
        withLabel:process_medium {
            cpus   = { 7     * task.attempt }
            memory = { 36.GB * task.attempt }
        }
        withLabel:process_high {
            cpus   = { 7      * task.attempt }
            memory = { 144.GB * task.attempt }
            time   = { 16.h   * task.attempt }
        }
        withLabel:process_long {
            queue  = 'batch'
            cpus   = { 8    * task.attempt }
            time   = { 20.h * task.attempt }
        }
        withLabel:error_ignore {
            errorStrategy = 'ignore'
        }
        withLabel:error_retry {
            errorStrategy = 'retry'
            maxRetries    = 2
        }

        // Where each kind of step runs (by process name; this pipeline has no analysis_type)
        // Taxonomic classification: high-memory node (Kraken2 loads the whole database)
        withName: 'KRAKEN2_KRAKEN2|BRACKEN_BRACKEN' {
            queue          = 'batch'
            clusterOptions = '--nodelist=compute05'
        }
        // Assembly and polishing
        withName: 'SHOVILL|AUTOCYCLER_ASSEMBLE|MEDAKA|POLYPOLISH_SHORTREAD|PYPOLCA_RUN|QUAST' {
            queue          = 'batch'
            clusterOptions = '--nodelist=compute05'
        }
        // Read alignment and phylogenetics
        withName: 'SNIPPY_RUN|SNIPPY_CONTIGS|SNIPPY_CORE|SNIPPY_CLEAN|GUBBINS|IQTREE|SNPDISTS' {
            queue          = 'batch'
            clusterOptions = '--nodelist=compute05'
        }
    }
  }
  docker {
    docker.enabled = true
    process {
        containerOptions = { params.kraken2_db ? "-v ${params.kraken2_db}:${params.kraken2_db}" : '' }
    }
  }
}
