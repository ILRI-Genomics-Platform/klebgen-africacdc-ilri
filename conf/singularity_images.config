/*
========================================================================================
    Shared, read-only Singularity / Apptainer images
========================================================================================
    Included, inside their `singularity` profile, by the site configs:
        conf/slurm.config    ILRI HPC (Slurm)
        conf/local.config    a single training server

    Every image is prepared once by a trainer with bin/prepare_shared_containers.sh
    and stored, read-only, under params.shared_container_dir:

        <shared_container_dir>/nf-core/   images for the nf-core modules
                                          (file names as Nextflow expects them)
        <shared_container_dir>/local/     images built for the course's local modules

    Participants never download or build images:
      - libraryDir is searched first and is never written to;
      - cacheDir points at the same read-only folder, so a missing image stops the
        run with an error instead of being downloaded.

    bin/prepare_shared_containers.sh reads the image names from this file, so the
    images it prepares always match what the pipeline asks for.
----------------------------------------------------------------------------------------
*/

singularity {
    enabled     = true
    autoMounts  = true
    libraryDir  = "${params.shared_container_dir}/nf-core"
    cacheDir    = "${params.shared_container_dir}/nf-core"
}

// Local modules: images built from each module's environment.yml, in <shared_container_dir>/local/.
// The pipeline checks these files exist before it starts (main.nf).
params {
    local_images = [
        KLEBORATE            : 'kleborate-3.2.4.sif',
        KAPTIVE              : 'kleborate-3.2.4.sif',   // same image: Kaptive is installed with Kleborate
        AUTOCYCLER_ASSEMBLE  : 'autocycler-0.6.2_flye-2.9.5_raven-1.6.1.sif',
        POLYPOLISH_SHORTREAD : 'polypolish-0.6.0_bwa-0.7.19.sif',
        EZCLERMONT           : 'ezclermont-1.0.0.sif',
    ]
}

process {
    withName: 'KLEBORATE' {
        container = "${params.shared_container_dir}/local/${params.local_images.KLEBORATE}"
    }
    withName: 'KAPTIVE' {
        container = "${params.shared_container_dir}/local/${params.local_images.KAPTIVE}"
    }
    withName: 'AUTOCYCLER_ASSEMBLE' {
        container = "${params.shared_container_dir}/local/${params.local_images.AUTOCYCLER_ASSEMBLE}"
    }
    withName: 'POLYPOLISH_SHORTREAD' {
        container = "${params.shared_container_dir}/local/${params.local_images.POLYPOLISH_SHORTREAD}"
    }
    withName: 'EZCLERMONT' {
        container = "${params.shared_container_dir}/local/${params.local_images.EZCLERMONT}"
    }
}
