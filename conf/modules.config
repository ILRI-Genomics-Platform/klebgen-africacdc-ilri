/*
========================================================================================
    Tool arguments (ext.args / ext.prefix) and where results are published
========================================================================================
    Trainees change analysis settings here, not in the modules themselves.
    Output folders are numbered by course module.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
    ]

    // ---------------------------------------------------------------- Module 1: QC
    withName: 'FASTP' {
        ext.args   = '--qualified_quality_phred 20 --length_required 50'
        publishDir = [
            path: { "${params.outdir}/01_qc/fastp" },
            mode: params.publish_dir_mode,
            pattern: '*.{html,json,log}',
        ]
    }
    withName: 'FILTLONG' {
        ext.args   = '--min_length 1000 --keep_percent 90'
        ext.prefix = { "${meta.id}.filtlong" }
        publishDir = [
            path: { "${params.outdir}/01_qc/filtlong" },
            mode: params.publish_dir_mode,
            pattern: '*.log',
        ]
    }
    withName: 'NANOPLOT' {
        ext.args   = { "--prefix ${meta.id}_" }
        publishDir = [
            path: { "${params.outdir}/01_qc/nanoplot/${meta.id}" },
            mode: params.publish_dir_mode,
        ]
    }
    withName: 'KRAKEN2_KRAKEN2' {
        publishDir = [
            path: { "${params.outdir}/01_qc/kraken2" },
            mode: params.publish_dir_mode,
            pattern: '*report.txt',
        ]
    }
    withName: 'BRACKEN_BRACKEN' {
        ext.args   = '-l S -t 10'
        publishDir = [
            path: { "${params.outdir}/01_qc/bracken" },
            mode: params.publish_dir_mode,
        ]
    }

    // ---------------------------------------------------------- Module 2: assembly
    withName: 'SHOVILL' {
        ext.args   = '--minlen 200'
        publishDir = [
            path: { "${params.outdir}/02_assembly/shovill" },
            mode: params.publish_dir_mode,
            pattern: '{contigs.fa,contigs.gfa,shovill.log}',
            saveAs: { filename -> "${meta.id}.${filename}" },
        ]
    }
    withName: 'AUTOCYCLER_ASSEMBLE' {
        ext.assemblers = 'flye raven'
        publishDir = [
            path: { "${params.outdir}/02_assembly/autocycler" },
            mode: params.publish_dir_mode,
        ]
    }
    // The polishing steps' intermediate assemblies are kept (small: 3 hybrid isolates in the training set) so
    // that course/make_precomputed.sh can give participants each step of Day 2, 2.5
    withName: 'MEDAKA' {
        ext.prefix = { "${meta.id}.medaka" }
        publishDir = [
            path: { "${params.outdir}/02_assembly/hybrid/medaka" },
            mode: params.publish_dir_mode,
        ]
    }
    withName: 'POLYPOLISH_SHORTREAD' {
        publishDir = [
            path: { "${params.outdir}/02_assembly/hybrid/polypolish" },
            mode: params.publish_dir_mode,
        ]
    }
    withName: 'PYPOLCA_RUN' {
        ext.args   = '--careful'
        ext.prefix = { "${meta.id}.hybrid" }
        publishDir = [
            path: { "${params.outdir}/02_assembly/hybrid" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('_corrected.fasta') ? "${meta.id}.hybrid.fasta" : filename },
        ]
    }
    withName: 'QUAST' {
        publishDir = [
            path: { "${params.outdir}/02_assembly/quast" },
            mode: params.publish_dir_mode,
        ]
    }
    withName: 'CHECKM2_PREDICT' {
        // One run per isolate. The per-isolate reports are merged by the assembly subworkflow into
        // 02_assembly/checkm2/quality_report.tsv (the file name the course pages use), so nothing is
        // published from the process itself; its run folder holds only DIAMOND intermediates.
        ext.prefix = { "${meta.id}" }
        publishDir = [enabled: false]
    }

    // ----------------------------------------------------------- Optional: annotation (--run_prokka)
    withName: 'PROKKA' {
        // Genus and species from the samplesheet; --addgenes adds a gene feature for every CDS.
        // --mincontiglen 200 drops tiny contigs that cannot be submitted to GenBank anyway.
        ext.args   = { meta.species == 'ecoli'
            ? "--kingdom Bacteria --genus Escherichia --species coli --strain ${meta.id} --mincontiglen 200 --addgenes"
            : "--kingdom Bacteria --genus Klebsiella --species pneumoniae --strain ${meta.id} --mincontiglen 200 --addgenes" }
        publishDir = [
            path: { "${params.outdir}/02_assembly/prokka" },
            mode: params.publish_dir_mode,
            pattern: '*/*.{gff,gbk,faa,ffn,fna,tsv,txt}',
        ]
    }

    withName: 'BAKTA_BAKTA' {
        // Same organism labels as Prokka; Bakta needs its own database (--bakta_db)
        ext.args   = { meta.species == 'ecoli'
            ? "--genus Escherichia --species coli --strain ${meta.id} --min-contig-length 200"
            : "--genus Klebsiella --species pneumoniae --strain ${meta.id} --min-contig-length 200" }
        publishDir = [
            path: { "${params.outdir}/02_assembly/bakta/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.{gff3,gbff,embl,faa,ffn,fna,tsv,txt,json}',
        ]
    }

    // ----------------------------------------- Modules 3, 4, 5, 7: typing and AMR
    withName: 'KLEBORATE' {
        publishDir = [
            path: { "${params.outdir}/03_typing/kleborate" },
            mode: params.publish_dir_mode,
        ]
    }
    withName: 'KAPTIVE' {
        publishDir = [
            path: { "${params.outdir}/03_typing/kaptive" },
            mode: params.publish_dir_mode,
        ]
    }
    withName: 'ECTYPER' {
        publishDir = [
            path: { "${params.outdir}/03_typing/ectyper" },
            mode: params.publish_dir_mode,
        ]
    }
    withName: 'EZCLERMONT' {
        publishDir = [
            path: { "${params.outdir}/03_typing/ezclermont" },
            mode: params.publish_dir_mode,
        ]
    }
    withName: 'AMRFINDERPLUS_UPDATE' {
        publishDir = [
            path: { "${params.outdir}/databases" },
            mode: params.publish_dir_mode,
        ]
    }
    withName: 'AMRFINDERPLUS_RUN' {
        ext.args   = '--plus'
        publishDir = [
            path: { "${params.outdir}/04_amr/amrfinderplus" },
            mode: params.publish_dir_mode,
        ]
    }
    withName: 'MOBSUITE_RECON' {
        publishDir = [
            path: { "${params.outdir}/05_plasmids/mobsuite/${meta.id}" },
            mode: params.publish_dir_mode,
        ]
    }

    // ---------------------------------------------------- Module 6: phylogeny
    withName: 'SNIPPY_RUN|SNIPPY_CONTIGS' {
        publishDir = [
            path: { "${params.outdir}/06_phylogeny/${meta.phylo_group}/snippy" },
            mode: params.publish_dir_mode,
            pattern: '*/*.{tab,txt,vcf}',
        ]
    }
    withName: 'SNIPPY_CORE' {
        publishDir = [
            path: { "${params.outdir}/06_phylogeny/${meta.id}" },
            mode: params.publish_dir_mode,
        ]
    }
    withName: 'SKA2' {
        // k-mer length 31 (the default); with reads, k-mers seen fewer than 5 times are ignored
        ext.args   = '-k 31'
        publishDir = [
            path: { "${params.outdir}/06_phylogeny/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.{full.aln,ska_distances.tsv,ska_inputs.tsv}',
        ]
    }
    withName: 'SNIPPY_CLEAN' {
        publishDir = [enabled: false]
    }
    withName: 'GUBBINS' {
        publishDir = [
            path: { "${params.outdir}/06_phylogeny/gubbins" },
            mode: params.publish_dir_mode,
        ]
    }
    withName: 'IQTREE' {
        // Alignment = recombination-filtered SNP sites only, so branch lengths
        // are per variable site; -B 1000 = ultrafast bootstrap support.
        // -st DNA: Gubbins leaves N for missing bases, and when an isolate has many
        // of them IQ-TREE's automatic type detection fails ('Unknown sequence type')
        ext.args   = '-st DNA -m GTR+G -B 1000'
        publishDir = [
            path: { "${params.outdir}/06_phylogeny/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.{treefile,contree,iqtree,log}',
        ]
    }
    withName: 'SNPDISTS' {
        publishDir = [
            path: { "${params.outdir}/06_phylogeny/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { _filename -> "${meta.id}.snp_distances.tsv" },
        ]
    }

    // ----------------------------------------------------------- Module 8: report
    withName: 'MULTIQC' {
        ext.args   = '--title "Neonatal AMR genomic surveillance"'
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
        ]
    }
}
