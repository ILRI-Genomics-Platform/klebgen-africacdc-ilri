/****************************************************************
 ********* Single training server (no scheduler) ****************
 ****************************************************************
 *
 *  nextflow run main.nf -profile singularity -c conf/local.config \
 *      --input samplesheet.csv --outdir results --kraken2_db /path/to/k2db
 *
 *  Tools run from the shared, read-only Singularity images prepared by a
 *  trainer (bin/prepare_shared_containers.sh); nothing is downloaded.
 *  Set shared_container_dir below once for the course.
 ***************************************************************/

params {
    // Read-only folder with the course images (nf-core/ and local/ inside)
    shared_container_dir = '/var/scratch/global/jjuma/neonatal-amr/shared/containers'
    // Read-only folder with the phylogeny reference genomes (bin/fetch_references.py)
    phylo_reference_dir  = '/var/scratch/global/jjuma/neonatal-amr/shared/references'
}

profiles {
  singularity {
    // Shared images: libraryDir/cacheDir and the local-module images
    includeConfig 'singularity_images.config'

    process {
        executor = 'local'
        // Many participants share one machine: keep each run small.
        // Raise these if each participant has a machine to themselves.
        resourceLimits = [cpus: 4, memory: 16.GB, time: 48.h]
    }
  }
}
