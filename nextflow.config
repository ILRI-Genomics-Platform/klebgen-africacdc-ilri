/*
========================================================================================
    neonatal-amr-nf: main configuration
========================================================================================
*/

params {
    // Input / output
    input                 = null          // samplesheet CSV (see assets/samplesheet.csv)
    input_type            = 'auto'        // auto | reads | assembly (auto: 'fastq_1' or 'fasta' column)
    outdir                = 'results'
    publish_dir_mode      = 'copy'

    // Databases (record their dates in every report)
    kraken2_db            = null          // Kraken2 DB directory with Bracken files; omit to skip
    amrfinderplus_db      = null          // AMRFinderPlus DB (.tar.gz or dir); omit to download the latest

    // Phylogeny / transmission (Module 6)
    skip_phylogeny        = false
    phylo_grouping        = 'kleborate'   // 'kleborate' (species + ST) or 'samplesheet' (phylo_group column)
    phylo_reference_sheet = "${projectDir}/conf/phylo_references.csv"   // kleborate mode: reference per species/ST
    phylo_reference_dir   = "${projectDir}/references"                  // kleborate mode: <accession>.fasta files
    phylo_references      = null          // samplesheet mode, optional CSV: group,fasta
    phylo_min_group_size  = 3             // groups with fewer isolates are skipped
    phylo_method          = 'snippy'      // snippy: map reads/contigs (Snippy); ska2: split k-mers (SKA2); both

    // Typing
    skip_kaptive          = false         // true: no standalone Kaptive report (Kleborate still reports K/O)

    // Genome annotation (optional)
    run_prokka            = false
    run_bakta             = false
    bakta_db              = null          // Bakta database folder (version 6, 'light' or 'full'); needed with --run_bakta

    // Shared read-only Singularity images, used with
    //   -profile singularity -c conf/slurm.config   (or conf/local.config).
    // Prepared by a trainer with bin/prepare_shared_containers.sh; usually set in that site config.
    shared_container_dir  = '/var/scratch/global/jjuma/neonatal-amr/shared/containers'
    local_images          = null          // set by conf/singularity_images.config

    // Show the help message and exit
    help                  = false

    // Reporting
    multiqc_config        = null
    trace_report_suffix   = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
}

// Resources per process label, then tool arguments and publishing
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
    }
    conda {
        conda.enabled           = true
        conda.channels          = ['conda-forge', 'bioconda']
        docker.enabled          = false
        singularity.enabled     = false
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        conda.channels          = ['conda-forge', 'bioconda']
        docker.enabled          = false
        singularity.enabled     = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        docker.runOptions       = '-u $(id -u):$(id -g)'
        conda.enabled           = false
        singularity.enabled     = false
        apptainer.enabled       = false
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
    }
    // Local modules pin conda packages but no container image: Wave builds
    // their containers from environment.yml (combine with docker/apptainer).
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'container,conda'
    }
    slurm {
        process.executor        = 'slurm'
    }
    // Cap requests for an 8-core / 32 GB machine (the local executor refuses
    // tasks that ask for more memory or CPUs than the computer has)
    laptop {
        process.resourceLimits  = [cpus: 8, memory: 30.GB, time: 48.h]
    }
    test      { includeConfig 'conf/test.config' }
}

// Container registries used by nf-core modules
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
apptainer.registry    = 'quay.io'
singularity.registry  = 'quay.io'

// Keep the environment of each process clean
env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
}

// Run reports
timeline { enabled = true; file = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt" }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html" }

manifest {
    name            = 'neonatal-amr-nf'
    description     = 'Training pipeline: neonatal AMR genomic surveillance of K. pneumoniae species complex and E. coli (Illumina + ONT)'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=25.04.0'
    version         = '1.0.0'
}
